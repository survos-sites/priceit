<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Stone collection · InventoryIt</title>{{ importmap('app') }}
<style>
[hidden]{display:none!important}*{box-sizing:border-box}body.stone-page{margin:0!important;background:#101914!important;color:#eef3e9!important;font-family:system-ui,sans-serif!important}button,select,input{font:inherit}button,a,select{touch-action:manipulation}button{cursor:pointer}a{color:#c7dfaa}.stone-app{max-width:1000px;margin:auto;padding:20px;padding-bottom:max(24px,env(safe-area-inset-bottom))}.stone-top{display:flex;justify-content:space-between;align-items:center;gap:20px}.eyebrow{font-size:11px;letter-spacing:.17em;text-transform:uppercase;color:#b6c9aa}h1{font-size:24px;margin:5px 0}p{line-height:1.5}.stone-site{display:flex;align-items:center;gap:12px;margin:20px 0}.stone-site select{flex:1;min-width:0;background:#243328;color:white;border:1px solid #4c614d;padding:12px;border-radius:12px}.stone-stage{position:relative;background:#19271e;border:1px solid #425342;border-radius:24px;overflow:hidden;height:min(48dvh,440px);min-height:240px}.stone-stage video{width:100%;height:100%;object-fit:contain}.stone-empty{position:absolute;inset:0;display:grid;place-content:center;text-align:center;padding:24px;color:#c3d1bc;pointer-events:none}.stone-empty[hidden]{display:none}.stone-chip{position:absolute;top:16px;left:16px;background:#101914d9;border:1px solid #627456;border-radius:30px;padding:9px 14px;font-size:13px}.stone-controls{display:grid;grid-template-columns:1fr auto;gap:20px;align-items:center;padding:22px 0}.stone-toggle{display:flex;gap:12px;align-items:center;font-size:16px;font-weight:650}.stone-toggle input{width:25px;height:25px;accent-color:#c9ed9a}.stone-hint{font-size:13px;color:#b6c9aa;margin:8px 0 0 37px}.stone-shutter{border:5px solid #607950;outline:2px solid #d7f2b4;background:#d7f2b4;color:#14200d;border-radius:50%;width:82px;height:82px;font-size:13px;font-weight:750}.stone-shutter:disabled{opacity:.4;cursor:wait}.stone-status{padding:12px 16px;background:#233328;border-radius:12px;font-size:14px}.stone-actions{display:flex;gap:12px;flex-wrap:wrap;margin:16px 0}.stone-actions button,.stone-site button,summary{background:#293b2e;color:#edf4e7;border:1px solid #51684d;border-radius:10px;padding:10px 14px}.stone-gallery{display:flex;gap:12px;overflow-x:auto;padding:10px 0}.stone-card{flex:0 0 120px;background:#233328;border-radius:12px;overflow:hidden}.stone-card img{width:120px;height:95px;object-fit:cover}.stone-card p{font-size:12px;margin:8px}.stone-note{font-size:12px;color:#aebda7}.stone-add{background:#233328;padding:16px;border-radius:12px;margin:15px 0}.stone-add input{padding:10px;max-width:100%;border-radius:8px}.stone-add button{padding:10px}summary{cursor:pointer;width:fit-content}.stone-held .stone-chip{background:#6c4817;border-color:#eac783}.stone-held .stone-toggle{color:#f4d18e}@media(min-width:760px){.stone-stage{height:54vh}.stone-controls{max-width:650px;margin:auto}}

.stone-app{padding-bottom:calc(82px + env(safe-area-inset-bottom))}.stone-tabs{position:fixed;z-index:1100;bottom:0;left:0;right:0;display:flex;padding:8px max(12px,env(safe-area-inset-right)) calc(8px + env(safe-area-inset-bottom));background:#17241c;border-top:1px solid #425342;gap:8px}.stone-tabs button{flex:1;min-height:48px;border:0;border-radius:12px;background:transparent;color:#b6c9aa;font-weight:650}.stone-tabs button[aria-pressed=true]{background:#d7f2b4;color:#14200d}.stone-map{height:55vh;min-height:260px;border-radius:16px;color:#17241c}.stone-settings{max-width:650px}.stone-settings label{display:block;margin:20px 0}.stone-settings input{display:block;background:#243328;color:white;border:1px solid #627456;border-radius:8px;padding:12px;margin:8px 0;width:160px}.stone-panel h2{font-size:20px}.stone-status{margin:12px 0}.stone-actions button{min-height:44px}.stone-shutter{flex-shrink:0}.stone-controls{min-width:0}.stone-chip{max-width:calc(100% - 32px)}
@media(orientation:landscape) and (min-width:600px){.stone-app{padding:10px max(16px,env(safe-area-inset-left)) calc(78px + env(safe-area-inset-bottom))}.stone-top h1{font-size:18px}.stone-site{margin:6px 0}.stone-note{margin:6px 0}.stone-camera-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(210px,30%);gap:20px}.stone-stage{height:calc(100dvh - 220px);min-height:160px}.stone-controls{display:flex;flex-direction:column;justify-content:center;gap:14px;padding:8px;max-width:none;margin:0}.stone-toggle{font-size:14px}.stone-hint{margin-left:0}.stone-shutter{width:70px;height:70px}.stone-actions{margin:8px 0}.stone-top .eyebrow{display:none}.stone-status{padding:8px 12px;font-size:12px}.stone-empty strong{display:none}.stone-empty p{margin:6px 0}.stone-map{height:calc(100dvh - 260px)}}
</style></head><body class="stone-page">
<main class="stone-app" data-controller="stone-capture" data-stone-capture-owner-value="{{ app.user.userIdentifier }}" data-stone-capture-upload-url-value="{{ path('stone_upload') }}" data-stone-capture-csrf-value="{{ csrf_token('stone_upload') }}">
<header class="stone-top"><div><span class="eyebrow">InventoryIt / gravestones</span><h1>One stone. Every detail.</h1></div><a href="{{ path('app_profiles') }}">Profiles</a></header>
<div class="stone-site"><span>Cemetery: &lt;auto&gt;</span><select hidden aria-label="Cemetery" data-stone-capture-target="cemetery"><option value="">Auto — not assigned yet</option></select></div>
<p class="stone-note" data-stone-capture-target="gps">GPS is required. Capture becomes available once a fresh location is acquired.</p>
<section class="stone-panel" data-stone-capture-target="panel" data-panel="camera" aria-label="Camera"><div class="stone-camera-layout"><section class="stone-stage"><video data-stone-capture-target="video" autoplay playsinline muted></video><div class="stone-empty" data-stone-capture-target="empty"><strong>Frame the whole stone.</strong><p>Start the camera, then keep shooting.<br>Each photo saves on this device immediately.</p><div class="stone-actions" style="justify-content:center;pointer-events:auto"><button data-action="stone-capture#start">Start camera</button></div></div><span class="stone-chip" data-stone-capture-target="context">Next shot → new stone</span></section>
<div class="stone-controls"><div><label class="stone-toggle"><input type="checkbox" checked data-stone-capture-target="advance" data-action="change->stone-capture#modeChanged">New stone after each photo</label><p class="stone-hint" data-stone-capture-target="hint">Every shot starts a new stone.</p></div><button class="stone-shutter" disabled data-stone-capture-target="shutter" data-action="stone-capture#snap" aria-label="Take photo">CAPTURE</button></div>
</div></section>
<section hidden class="stone-panel" data-stone-capture-target="panel" data-panel="map" aria-label="Map"><h2>Collected stones</h2><p class="stone-note" data-stone-capture-target="mapStatus">Loading saved locations…</p><div class="stone-map" data-stone-capture-target="map" aria-label="Map of capture locations"></div><div class="stone-actions"><button data-action="stone-capture#centerMap">Center on my location</button></div></section>
<section hidden class="stone-panel stone-settings" data-stone-capture-target="panel" data-panel="settings" aria-label="Settings"><h2>Capture settings</h2><div class="stone-actions"><button data-action="stone-capture#stop">Stop camera</button></div><div class="stone-actions"><button data-action="stone-capture#enableOrientation">Enable orientation sensors</button></div><p class="stone-note" data-stone-capture-target="orientation">Enable sensors to record device tilt and direction when available.</p><label>Approximate distance to stone (feet)<input type="number" min="0.1" step="any" inputmode="decimal" placeholder="e.g. 3" data-stone-capture-target="distance" data-action="change->stone-capture#preferences"></label><p class="stone-note">Optional estimate, reused for following shots until you change or clear it. This is not a measured distance. GPS records the camera position; sensor angles are uncalibrated.</p><div class="stone-actions"><button data-action="stone-capture#exportPhotos">Export photos + metadata</button></div><p role="status" aria-live="polite" data-stone-capture-target="syncStatus">Checking uploads…</p><div class="stone-actions"><button data-action="stone-capture#sync">Retry uploads to SSAI</button></div><h2>On this device <span data-stone-capture-target="count"></span></h2><div class="stone-gallery" data-stone-capture-target="gallery"></div><p class="stone-note">Photos upload to SSAI when connected. Local copies stay here as a backup; keep them until upload is confirmed. OCR and cemetery resolution remain separate steps. Cemetery: &lt;auto&gt;.</p></section>
<div class="stone-status" role="status" aria-live="polite" data-stone-capture-target="status">Ready when you are.</div>
<nav class="stone-tabs" aria-label="Collection views">
<button type="button" aria-pressed="true" data-panel="camera" data-stone-capture-target="tab" data-action="stone-capture#showPanel">Camera</button>
<button type="button" aria-pressed="false" data-panel="map" data-stone-capture-target="tab" data-action="stone-capture#showPanel">Map</button>
<button type="button" aria-pressed="false" data-panel="settings" data-stone-capture-target="tab" data-action="stone-capture#showPanel">Settings</button>
</nav></main></body></html>
