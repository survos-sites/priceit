{#
    Framework7 form theme.

    The app has two asset paths on purpose -- importmap('admin') carries Tabler/Bootstrap for
    the review screens, importmap('app') carries Framework7 for the phone -- and they must
    stay apart. bootstrap_5_layout is the right global default because most forms in this
    codebase are admin forms, but it emits .form-control and .mb-3, which exist only on the
    admin path. Pulling Bootstrap's CSS into the F7 entrypoint to make /login and /register
    look right would collapse that separation for two pages.

    So those two pages override the theme instead, and this file speaks F7's own markup:
    a .list of .item-content.item-input rows, which is what the rest of the app already
    looks like.
#}
{# parent() in a form theme resolves through this, not through extends. #}
{% use 'form_div_layout.html.twig' %}

{% block form_start %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' list list-strong-ios list-outline-ios list-dividers-ios')|trim}) %}
    {{ parent() }}
    <ul>
{% endblock %}

{% block form_end %}
    </ul>
    {# parent() emits form_rest then </form>, so the unrendered fields (the CSRF token) land
       outside the <ul>: a hidden <input> as a direct child of the list would still occupy a
       row in F7's layout. #}
    {{ parent() }}
{% endblock %}

{% block form_row %}
    <li>
        <div class="item-content item-input{{ errors|length ? ' item-input-invalid item-input-with-error-message' : '' }}">
            <div class="item-inner">
                {{ form_label(form) }}
                <div class="item-input-wrap">
                    {{ form_widget(form) }}
                    {{ form_errors(form) }}
                </div>
            </div>
        </div>
    </li>
{% endblock %}

{% block form_label %}
    {% if label is not same as(false) %}
        <div class="item-title item-label">{{ label|default(name|humanize)|trans({}, translation_domain) }}</div>
    {% endif %}
{% endblock %}

{% block form_errors %}
    {% for error in errors %}
        <div class="item-input-error-message">{{ error.message }}</div>
    {% endfor %}
{% endblock %}

{% block checkbox_row %}
    {# Not an item-input: F7 renders a checkbox as a whole tappable row with the label as the
       row title, so wrapping it in an input row would give it two labels and a dead one. #}
    <li>
        <label class="item-checkbox item-content">
            {{ form_widget(form) }}
            <i class="icon icon-checkbox"></i>
            <div class="item-inner">
                <div class="item-title">{{ label|default(name|humanize)|trans({}, translation_domain) }}</div>
            </div>
        </label>
        {% if errors|length %}
            <div class="item-input-error-message" style="padding: 0 16px 8px;">{{ form_errors(form) }}</div>
        {% endif %}
    </li>
{% endblock %}

{% block submit_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' button button-fill button-large')|trim}) %}
    {{ parent() }}
{% endblock %}
