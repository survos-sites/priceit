{% extends 'base.html.twig' %}

{% block title %}Sign in — PriceIt{% endblock %}
{% block navbar_title %}Sign in{% endblock %}

{% block body %}
    {# Hand-written rather than a Symfony form: form_login reads _username/_password straight
       off the request, so there is no form type here for form/f7_layout.html.twig to theme.
       The markup mirrors that theme by hand so this page and /register look like one app.
       The Bootstrap classes it shipped with (.form-control, .btn, .alert) style nothing in
       the F7 shell -- Bootstrap lives on the importmap('admin') path only. #}

    {% for message in app.flashes('success') %}
        <div class="block block-strong inset">{{ message }}</div>
    {% endfor %}

    {% if error %}
        <div class="block block-strong inset text-color-red">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    {% if app.user %}
        <div class="block block-strong inset">
            Signed in as {{ app.user.userIdentifier }} —
            <a href="{{ logout_path() }}">log out</a>
        </div>
    {% endif %}

    <form method="post" class="list list-strong-ios list-outline-ios list-dividers-ios">
        <ul>
            <li>
                <div class="item-content item-input">
                    <div class="item-inner">
                        <div class="item-title item-label">Email</div>
                        <div class="item-input-wrap">
                            <input type="email" name="_username" id="username"
                                   value="{{ last_username }}"
                                   autocomplete="email" required autofocus>
                        </div>
                    </div>
                </div>
            </li>
            <li>
                <div class="item-content item-input">
                    <div class="item-inner">
                        <div class="item-title item-label">Password</div>
                        <div class="item-input-wrap">
                            <input type="password" name="_password" id="password"
                                   autocomplete="current-password" required>
                        </div>
                    </div>
                </div>
            </li>
        </ul>

        <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
               value="{{ csrf_token('authenticate') }}">

        <div class="block">
            <button class="button button-fill button-large" type="submit">Sign in</button>
        </div>
    </form>

    <div class="block-footer text-align-center">
        No account? <a href="{{ path('app_register') }}">Create one</a>
    </div>
{% endblock %}
