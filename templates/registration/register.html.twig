{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
    {% for flash_error in app.flashes('verify_email_error') %}
        <div class="block block-strong inset text-color-red">{{ flash_error }}</div>
    {% endfor %}

    <div class="block-title block-title-large">Register</div>

    {{ form_errors(registrationForm) }}

    {# Bootstrap is the global default (admin path); these two pages live in the F7 shell,
       which has no Bootstrap CSS and must not gain any. #}
    {% form_theme registrationForm 'form/f7_layout.html.twig' %}

    {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.email) }}
        {{ form_row(registrationForm.plainPassword, {
            label: 'Password'
        }) }}
        {{ form_row(registrationForm.agreeTerms) }}

        {# F7 classes, not .btn: the theme cannot reach a button the template writes by hand. #}
        <div class="block">
            <button type="submit" class="button button-fill button-large">Register</button>
        </div>
    {{ form_end(registrationForm) }}
{% endblock %}
