{% extends 'site_shell.html.twig' %}
{% block title %}Choose a profile · InventoryIt{% endblock %}
{% block body %}<span class="eyebrow">Choose your collection</span><h1>What are you collecting?</h1><p class="lead">A focused workspace for each kind of collection. Open a site here, or scan its code to start on your phone.</p>
<div class="grid">{% for site in sites %}<article class="card"><span class="eyebrow">{{ site.profile }}</span><h2><a href="{{ site.siteUrl }}">{{ site.name }}</a></h2><p>{{ site.description }}</p><a class="button" href="{{ site.siteUrl }}">Explore {{ site.name }}</a><div class="qr-row">{% if site.phoneUrl %}<a href="{{ site.phoneUrl }}"><img class="qr" src="{{ qr_code_url(site.phoneUrl) }}" alt="Scan to open {{ site.name }} on your phone"></a><div><strong>Open on your phone</strong><p class="small"><a href="{{ site.phoneUrl }}">{{ site.phoneUrl }}</a></p></div>{% else %}<p class="small">Configure a public tunnel URL to enable phone access.</p>{% endif %}</div></article>{% endfor %}</div>{% endblock %}
