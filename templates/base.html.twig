<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <title>{% block title %}PriceIt{% endblock %}</title>
        {{ pwa() }}
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body data-turbo="false">
        <div id="app" class="framework7-root safe-areas" {{ stimulus_controller('f7') }}>
            <div class="view view-main view-init safe-areas" data-url="/">
                <div class="page page-current">
                    <div class="navbar">
                        <div class="navbar-bg"></div>
                        <div class="navbar-inner">
                            <div class="title">{% block navbar_title %}PriceIt{% endblock %}</div>
                        </div>
                    </div>

                    <div class="page-content">
                        {% block body %}{% endblock %}
                    </div>

                    {% block toolbar %}
                        {# Real hrefs, not F7 in-page tabs.
                           fw7-demo's tabbar drives href="#tab-name" against content already in
                           the document, switched client-side. PriceIt renders every page on the
                           server and f7_controller deliberately disables F7's router
                           (clicks.externalLinks: 'a'), so anchors here must be ordinary
                           navigations. Same markup and the same look; the active tab is decided
                           server-side from the route instead of by F7. #}
                        {% set _route = app.request.attributes.get('_route') %}
                        {% set _tabs = [
                            {route: 'item_capture',   label: 'Capture', icon: 'camera_fill'},
                            {route: 'app_item_index', label: 'Items',   icon: 'square_list_fill', active_for: ['app_item_show']}
                        ] %}
                        <div class="toolbar tabbar toolbar-bottom">
                            <div class="toolbar-inner">
                                {% for tab in _tabs %}
                                    {# A detail page keeps its section lit: dropping into an item
                                       is still being in Items, and a tabbar that goes blank there
                                       reads as having left the app. #}
                                    {% set _active = _route == tab.route or _route in (tab.active_for|default([])) %}
                                    <a href="{{ path(tab.route) }}" class="tab-link{{ _active ? ' tab-link-active' : '' }}">
                                        <i class="icon f7-icons">{{ tab.icon }}</i>
                                        <span class="tabbar-label">{{ tab.label }}</span>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endblock %}
                </div>
            </div>
        </div>
    </body>
</html>
