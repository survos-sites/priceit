<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <title>{% block title %}PriceIt{% endblock %}</title>
        {{ pwa() }}
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body data-turbo="false">
        <div id="app" class="framework7-root safe-areas" {{ stimulus_controller('f7') }}>
            <div class="view view-main view-init safe-areas" data-url="/">
                <div class="page page-current">
                    <div class="navbar">
                        <div class="navbar-bg"></div>
                        <div class="navbar-inner">
                            <div class="title">{% block navbar_title %}PriceIt{% endblock %}</div>
                        </div>
                    </div>

                    <div class="page-content">
                        {% block body %}{% endblock %}
                    </div>

                    {% block toolbar %}
                        {# fw-bundle's own tabbar. MOBILE_TAB_MENU_LINKED renders real hrefs with
                           the active tab resolved by KnpMenu's route matcher; App\Menu\TabMenu
                           supplies the items. This was a hardcoded array here with a hand-rolled
                           active state, including an active_for list the matcher makes redundant. #}
                        <div class="toolbar tabbar toolbar-bottom">
                            <div class="toolbar-inner">
                                <twig:mobile_menu type="MOBILE_TAB_MENU_LINKED" caller="base.html.twig" />
                            </div>
                        </div>
                    {% endblock %}
                </div>
            </div>
        </div>
    </body>
</html>
