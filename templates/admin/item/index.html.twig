{% extends 'admin/base.html.twig' %}

{% block title %}Items{% endblock %}

{% block body %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Photo</th>
                        <th>Title</th>
                        <th>Media</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Captured</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        {% set photos = item.photos %}
                        <tr>
                            <td>
                                {% if photos|length %}
                                    <img src="{{ vich_uploader_asset(photos[0], 'file') }}" class="rounded" width="56" height="56" style="object-fit: cover;" alt="">
                                {% else %}
                                    <span class="avatar avatar-md bg-secondary-lt"></span>
                                {% endif %}
                            </td>
                            <td><a href="{{ path('admin_item_show', {id: item.id}) }}">{{ item.title ?? 'Untitled item #' ~ item.id }}</a></td>
                            <td class="text-secondary">{{ photos|length }} photo(s){{ item.audio ? ' · audio note' : '' }}</td>
                            <td>{{ item.price is not null ? '$' ~ item.price : '—' }}</td>
                            <td><span class="badge bg-blue-lt">{{ item.marking }}</span></td>
                            <td class="text-secondary">{{ item.createdAt|date('M j, g:ia') }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-secondary py-4">No items captured yet — go take some photos in the mobile app.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
