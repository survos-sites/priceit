<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    {# Not base.html.twig: its navbar and tab bar left the viewfinder a small box, and a lamp does
       not fit in a small box. This page is the whole screen. #}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#000000">
    <title>Price it · PriceIt</title>
    {{ pwa() }}
    {{ importmap('app') }}
    <style>
        html, body { margin: 0; height: 100%; background: #000; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        .lk { position: fixed; inset: 0; color: #fff; background: #000; }
        .lk section { position: absolute; inset: 0; }
        .lk [hidden] { display: none !important; }

        /* Step 1: the viewfinder is the screen. */
        .lk-camera video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: #000; }
        .lk-hint { position: absolute; top: calc(14px + env(safe-area-inset-top)); left: 0; right: 0; margin: 0;
            text-align: center; font-size: 15px; text-shadow: 0 1px 3px rgba(0,0,0,.8); padding: 0 70px; }
        .lk-torch { position: absolute; top: calc(8px + env(safe-area-inset-top)); right: 12px; width: 48px; height: 48px;
            border-radius: 50%; border: 0; background: rgba(0,0,0,.45); color: #fff; font-size: 22px; }
        .lk-torch.on { background: #ffd60a; color: #000; }
        .lk-bottom { position: absolute; left: 0; right: 0; bottom: calc(22px + env(safe-area-inset-bottom));
            display: flex; align-items: center; justify-content: space-around; }
        .lk-shutter { width: 84px; height: 84px; border-radius: 50%; border: 6px solid rgba(255,255,255,.55);
            background: #fff; background-clip: padding-box; }
        .lk-shutter:active { transform: scale(.94); }
        .lk-side { width: 64px; display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 12px;
            text-align: center; text-shadow: 0 1px 3px rgba(0,0,0,.8); cursor: pointer; }
        .lk-side span { width: 52px; height: 52px; border-radius: 50%; background: rgba(0,0,0,.45);
            display: flex; align-items: center; justify-content: center; font-size: 24px; }
        .lk-error { position: absolute; top: 40%; left: 24px; right: 24px; text-align: center; font-size: 16px; }

        /* Step 2: the photo, while the answer comes back. */
        .lk-research { background: #000; }
        .lk-research img { width: 100%; height: 100%; object-fit: contain; }
        .lk-overlay { position: absolute; left: 0; right: 0; bottom: 0; padding: 28px 20px calc(34px + env(safe-area-inset-bottom));
            background: linear-gradient(transparent, rgba(0,0,0,.85) 40%); text-align: center; }
        .lk-overlay p { margin: 10px 0 0; font-size: 22px; font-weight: 700; }
        .lk-spinner { width: 34px; height: 34px; margin: 0 auto; border: 4px solid rgba(255,255,255,.3);
            border-top-color: #fff; border-radius: 50%; animation: lk-spin .9s linear infinite; }
        @keyframes lk-spin { to { transform: rotate(360deg); } }
        .lk-retry { margin: 16px 6px 0; display: inline-block; padding: 12px 22px; border-radius: 12px; border: 0;
            background: #fff; color: #000; font-size: 17px; font-weight: 600; }

        /* Step 3: the answer. */
        .lk-result { overflow-y: auto; background: #f2f2f7; color: #1c1c1e; -webkit-overflow-scrolling: touch; }
        .lk-result .photo { display: block; width: 100%; max-height: 34vh; object-fit: cover; background: #000; }
        .lk-card { background: #fff; margin: -18px 12px 0; position: relative; border-radius: 16px; padding: 16px;
            box-shadow: 0 2px 10px rgba(0,0,0,.12); }
        .lk-card h2 { margin: 0 0 6px; font-size: 22px; line-height: 1.25; }
        .lk-price { font-size: 52px; font-weight: 800; line-height: 1.05; margin: 8px 0 0; }
        .lk-note { font-size: 14px; color: #6b6b70; margin: 2px 0 12px; }
        .lk-line { font-size: 17px; margin: 0 0 8px; }
        .lk-why { font-size: 16px; line-height: 1.45; margin: 10px 0; }
        .lk-desc { font-size: 14px; color: #3a3a3c; font-style: italic; margin: 0; }
        .lk-conf { display: inline-block; font-size: 13px; font-weight: 600; padding: 3px 10px; border-radius: 99px; }
        .lk-conf.high { background: #d8f5df; color: #1a6b32; }
        .lk-conf.medium { background: #fff1d6; color: #8a5a00; }
        .lk-conf.low { background: #ffe0dd; color: #a3261a; }
        .lk-next { display: block; width: calc(100% - 24px); margin: 16px 12px calc(20px + env(safe-area-inset-bottom));
            min-height: 60px; border: 0; border-radius: 14px; background: #E67E22; color: #fff; font-size: 20px; font-weight: 700; }
    </style>
</head>
<body>
<div class="lk" {{ stimulus_controller('lookup', { url: path('app_lookup_ask') }) }}>

    <section class="lk-camera" data-lookup-target="cameraStep">
        <video data-lookup-target="video" playsinline muted autoplay></video>
        <p class="lk-hint">Fill the screen with the item, maker's mark or tag included</p>
        <button type="button" class="lk-torch" hidden data-lookup-target="torch" data-action="lookup#toggleTorch" aria-label="Flashlight">🔦</button>
        <p class="lk-error" hidden data-lookup-target="cameraError" data-action="click->lookup#retryCamera"></p>

        <div class="lk-bottom">
            <label class="lk-side"><span>🖼️</span>Photos
                <input type="file" accept="image/*" hidden data-action="change->lookup#pick">
            </label>
            <button type="button" class="lk-shutter" data-action="lookup#shoot" aria-label="Take the photo"></button>
            {# The phone's own camera app: flash, night mode and the 0.5x lens for things too
               big to fit, none of which a web page can reach. #}
            <label class="lk-side"><span>📱</span>Camera app
                <input type="file" accept="image/*" capture="environment" hidden data-action="change->lookup#pick">
            </label>
        </div>
    </section>

    <section class="lk-research" hidden data-lookup-target="researchStep">
        <img data-lookup-target="preview" alt="">
        <div class="lk-overlay">
            <div class="lk-spinner" data-lookup-target="spinner"></div>
            <p data-lookup-target="status">Researching…</p>
            <div data-lookup-target="retry" hidden>
                <button type="button" class="lk-retry" data-action="lookup#send">Try again</button>
                <button type="button" class="lk-retry" data-action="lookup#next">New photo</button>
            </div>
        </div>
    </section>

    <section class="lk-result" hidden data-lookup-target="resultStep">
        <img class="photo" data-lookup-target="resultPhoto" alt="">
        <div data-lookup-target="result"></div>
        <button type="button" class="lk-next" data-action="lookup#next">📷 Next item</button>
    </section>
</div>
</body>
</html>
