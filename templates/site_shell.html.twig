<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{% block title %}InventoryIt{% endblock %}</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f4f4ee;color:#23352b;font:16px/1.6 system-ui,sans-serif}a{color:inherit}header,main{max-width:1200px;margin:auto;padding:24px}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #d6ddce}header a{text-decoration:none;font-weight:700}.brand{letter-spacing:-.05em;font-size:24px}.eyebrow{font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:#66795e}h1{font-size:clamp(32px,4vw,48px);line-height:1.07;letter-spacing:-.045em;max-width:750px;margin:20px 0}h2{line-height:1.2;font-size:25px}p{max-width:600px}.lead{font-size:21px;color:#5b6b58}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin:36px 0}.card{background:#fff;border:1px solid #d6ddce;border-radius:20px;padding:28px}.qr-row{display:flex;align-items:center;gap:24px;margin-top:24px}.qr{width:132px;height:132px;flex-shrink:0}.small{font-size:13px;color:#64705f;overflow-wrap:anywhere}.button{display:inline-block;background:#284834;color:white;padding:12px 20px;border-radius:10px;text-decoration:none;font-weight:650}.layout{display:grid;grid-template-columns:1.2fr 1fr;gap:70px;padding-top:28px;align-items:start}.phone{border:10px solid #243529;border-radius:36px;overflow:hidden;width:390px;max-width:100%;height:660px;background:#101914;box-shadow:0 20px 60px #22331b25;margin:auto}.phone iframe{width:100%;height:100%;border:0;background:white}.caption{text-align:center;font-size:13px;color:#64705f}.note{padding:18px 20px;background:#e8edde;border-radius:12px;margin:24px 0}footer{padding:30px 24px;max-width:1200px;margin:auto;color:#64705f;font-size:13px}@media(max-width:800px){.grid,.layout{grid-template-columns:1fr;gap:24px}.layout{padding-top:12px}.qr-row{gap:14px}.phone{height:680px}header,main{padding:20px}.qr{width:112px;height:112px}}
</style></head><body><header><a class="brand" href="{{ path('app_profiles') }}">InventoryIt<span style="color:#7f9865">.</span></a><span class="eyebrow">Capture with purpose</span></header><main>{% block body %}{% endblock %}</main><footer>One collection at a time. Built for the work in front of you.</footer></body></html>
