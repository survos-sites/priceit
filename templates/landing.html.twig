{# Standalone on purpose: this is a shop window, not an admin screen. Extending
   the Tabler layout dragged in the sidebar, the "myProject" brand and a
   breadcrumb showing the route name — chrome that belongs on /admin. #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>PriceIt — price a garage sale from your phone</title>
    {{ importmap('admin') }}
    <style>

        /* Scoped to the landing so nothing here reaches the admin pages. */
        #landing .lead { font-size: 1.125rem; }

        #landing .phone-mock {
            width: 360px;
            max-width: 100%;
            aspect-ratio: 9 / 16;   /* 19 pushed the QR below the fold on a laptop */
            border: 14px solid #2f2f2f;
            border-radius: 34px;
            overflow: hidden;
            box-shadow: 0 12px 30px rgba(0, 0, 0, .25);
            background: #000;
        }
        #landing .phone-mock iframe {
            width: 100%;
            height: 100%;
            border: 0;
            display: block;
        }

        /* Keep the phone in view while the copy scrolls past it. */
        @media (min-width: 992px) {
            #landing .phone-sticky { position: sticky; top: 2rem; }
        }

        #landing .qr { max-width: 150px; }
        #landing .step { counter-increment: step; }
        #landing .step-num {
            display: inline-flex; align-items: center; justify-content: center;
            width: 1.75rem; height: 1.75rem; border-radius: 50%;
            background: #206bc4; color: #fff; font-weight: 600; font-size: .9rem;
            flex: 0 0 auto;
        }
    </style>
</head>
<body>
<section id="landing" class="container-xl py-5">
    <div class="row justify-content-between align-items-start g-5">

        <div class="col-lg-6 order-2 order-lg-1">
            <h1 class="mb-3">PriceIt</h1>
            <p class="lead text-secondary">
                A garage sale is an inventory problem. Walk around with your phone, photograph
                each item, say a few words about it, and let the rest happen on its own —
                a title, a description with some charm, and a price.
            </p>

            <div class="card mt-4">
                <div class="card-body">
                    <h2 class="h3 mb-3">How it goes</h2>
                    <ul class="list-unstyled mb-0">
                        <li class="d-flex gap-3 mb-3 step">
                            <span class="step-num">1</span>
                            <span>Snap a photo or three. Record a spoken note if there's
                                something the camera can't see.</span>
                        </li>
                        <li class="d-flex gap-3 mb-3 step">
                            <span class="step-num">2</span>
                            <span>It queues on the phone and uploads in the background —
                                the whole thing works with no signal and catches up later.</span>
                        </li>
                        <li class="d-flex gap-3 mb-3 step">
                            <span class="step-num">3</span>
                            <span>AI reads the photos and proposes a title, a description
                                and a garage-sale price.</span>
                        </li>
                        <li class="d-flex gap-3 step">
                            <span class="step-num">4</span>
                            <span>Approve it and a price tag comes out of the Zebra, QR and all.</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="row g-3 mt-3">
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h3 class="h4">Offline first</h3>
                            <p class="text-secondary mb-0">
                                Captures live in an IndexedDB outbox until they're safely
                                uploaded. A closed tab or a dead connection loses nothing.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h3 class="h4">Straight to a label</h3>
                            <p class="text-secondary mb-0">
                                Depot owns the Zebra. PriceIt hands it the ZPL and is told
                                whether it printed — no queue to watch.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2 flex-wrap">
                <a href="{{ captureUrl }}" class="btn btn-primary">Open the capture app</a>
                <a href="{{ adminUrl }}" class="btn btn-outline-secondary">Review &amp; price items</a>
            </div>
        </div>

        <div class="col-lg-5 order-1 order-lg-2 phone-sticky">
            <div class="phone-mock mx-auto">
                {# Same-origin on purpose: the frame shows this machine's app, so it
                   works whether or not the tunnel is up. The QR is what carries the
                   public URL. #}
                <iframe src="{{ embeddedUrl }}" loading="lazy" title="PriceIt capture app"></iframe>
            </div>

            <div class="text-center mt-3">
                <figure class="figure mb-2">
                    <a href="{{ phoneUrl }}" target="_blank" rel="noopener">
                        <img class="figure-img img-fluid qr" src="{{ qr_code_url(phoneUrl) }}" alt="Scan to open PriceIt on your phone">
                    </a>
                </figure>
                <p class="text-secondary small mb-1">Scan it — the camera flow wants a real phone.</p>
                <p class="text-secondary small mb-0"><code>{{ phoneUrl }}</code></p>

                {% if not tunnelConfigured %}
                    <div class="alert alert-warning mt-3 text-start small mb-0">
                        <strong>That QR only works on this machine.</strong>
                        <code>PRICEIT_PUBLIC_URL</code> isn't set, so it points at
                        <code>{{ absoluteCaptureUrl }}</code>, which a phone can't reach.
                        Point it at the cloudflared hostname to test on a handset.
                    </div>
                {% endif %}
            </div>
        </div>

    </div>
</section>
</body>
</html>
