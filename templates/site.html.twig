{% extends 'site_shell.html.twig' %}
{% block title %}{{ site.name }} · InventoryIt{% endblock %}
{% block body %}<div class="layout"><section><a class="small" href="{{ path('app_profiles') }}">← All profiles</a><p class="eyebrow">InventoryIt / {{ site.name }}</p><h1>{{ site.description }}</h1><p class="lead">{{ site.detail }}</p><a class="button" href="{{ path('profile_app', {profile: site.profile}) }}">Open {{ site.name }} app</a><div class="note">{{ site.note }}</div><div class="qr-row">{% if site.phoneUrl %}<a href="{{ site.phoneUrl }}"><img class="qr" src="{{ qr_code_url(site.phoneUrl) }}" alt="Scan to open {{ site.name }} on your phone"></a><div><strong>Take it with you.</strong><p class="small">Scan to open this profile on your phone.</p><a class="small" href="{{ site.phoneUrl }}">{{ site.phoneUrl }}</a></div>{% endif %}</div></section><section><div class="phone"><iframe src="{{ site.appUrl }}" title="{{ site.name }} mobile app" allow="camera; geolocation; microphone; accelerometer; gyroscope; magnetometer"></iframe></div><p class="caption">The live mobile app. Sign in to start collecting.</p></section></div>{% endblock %}
