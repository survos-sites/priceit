{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-pdo_pgsql": "*",
        "api-platform/doctrine-orm": "^4.3.18 || ^5.0.5",
        "api-platform/symfony": ">=5.0.5",
        "doctrine/doctrine-bundle": "^3.3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.7.5",
        "endroid/qr-code-bundle": "^7.0.2",
        "league/flysystem-aws-s3-v3": "^3.35",
        "league/flysystem-bundle": "^3.7",
        "nyholm/psr7": "^1.8",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.3.6",
        "spomky-labs/pwa-bundle": ">=1.5.14",
        "survos/auth-bundle": "^2.42.23",
        "survos/brevo-bundle": "^2.42.14",
        "survos/doc-bundle": "^2.41.9",
        "survos/ebay-php": "^2.41.9",
        "survos/etsy-php": "^2.41.9",
        "survos/fw-bundle": ">=2.43.21",
        "survos/marketplace-bundle": "^2.41.9",
        "survos/mercadolibre-php": "^2.41.9",
        "survos/quickbase-bundle": "^2.41.9",
        "survos/quickbase-php": "^2.41.9",
        "survos/supervisor-bundle": "^2.41.9",
        "survos/tabler-bundle": "^2.42.23",
        "survos/workflow-extras-bundle": "^2.42.13",
        "survos/workflow-messenger-bundle": "^2.42.13",
        "symfony/ai-anthropic-platform": "^1.0.0-beta1",
        "symfony/ai-platform": "^1.0.0-beta1",
        "symfony/asset": "^8.1",
        "symfony/asset-mapper": "^8.1",
        "symfony/brevo-mailer": "^8.1",
        "symfony/console": "^8.1",
        "symfony/doctrine-messenger": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/expression-language": "^8.1",
        "symfony/flex": "^2",
        "symfony/form": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/intl": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/mime": "^8.1",
        "symfony/monolog-bundle": "^3.0|^4.1",
        "symfony/notifier": "^8.1",
        "symfony/process": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "symfony/remote-event": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/stimulus-bundle": "^3.6.0",
        "symfony/string": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/ux-turbo": "^3.6.0",
        "symfony/validator": "^8.1",
        "symfony/web-link": "^8.1",
        "symfony/webhook": "^8.1",
        "symfony/yaml": "^8.1",
        "symfonycasts/verify-email-bundle": "^1.18",
        "twig/extra-bundle": "^2.12|^3.29",
        "twig/twig": "^2.12|^3.30",
        "vich/uploader-bundle": ">=3"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Survos\\CameraBundle\\": "src/CameraBundle/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "pwa:compile": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^8.2"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.3",
        "survos/deployment-bundle": "^2.43.21",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/debug-bundle": "^8.1",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "^8.1",
        "symfony/web-profiler-bundle": "^8.1"
    }
}
