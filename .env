# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# The shared Docker Postgres (~/sites/docker), same instance ssai and kpa use.
# SQLite is for tests only: it cannot add a NOT NULL column without a default,
# and its migrations (CREATE TEMPORARY TABLE __temp__item) will not run on the
# Postgres this app deploys to — so dev on SQLite meant dev migrations that
# production could never execute.
DATABASE_URL="postgresql://postgres:docker@127.0.0.1:5434/priceit?serverVersion=18&charset=utf8"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> media storage ###
# Hetzner Object Storage. Bucket "priceit" carries a public-read bucket policy,
# so uploaded photos are servable directly and MEDIA_URI_PREFIX is the bucket's
# public base. Empty credentials fall back to the local dev directory.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
AWS_S3_BUCKET_NAME=priceit
AWS_S3_ACCESS_ID=
AWS_S3_ACCESS_SECRET=
MEDIA_URI_PREFIX=/uploads/media
###< media storage ###

###> priceit ###
# Anthropic API key for the pricing suggestion. Blank = the AI button reports
# itself unconfigured rather than failing at click time.
ANTHROPIC_API_KEY=
PRICEIT_AI_MODEL=claude-opus-5

# Quickbase REST API. Keep the real token in .env.local or deployment secrets.
QUICKBASE_REALM=kristinlamperaza.quickbase.com
QUICKBASE_API_KEY=

# Depot owns the Zebra printer. Blank = labels are still built and previewable,
# just not sent anywhere.
DEPOT_BASE_URL=
DEPOT_TENANT_ID=default
DEPOT_PRINTER_PROFILE=
###< priceit ###

# Public hostname the phone can actually reach (cloudflared tunnel).
PRICEIT_PUBLIC_URL=

###> survos/marketplace-bundle ###
# eBay application keyset (yours, from developer.ebay.com -- NOT the seller's login).
# Sandbox and production keysets are separate and not interchangeable.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The redirect-URI ALIAS from the developer portal, not a URL.
EBAY_RU_NAME=

# Which survos_marketplace connection the "Post to eBay" button uses.
# Blank disables the button rather than failing at boot.
EBAY_CONNECTION=

# Per-seller, filled in after the seller authorizes the app. Create the location
# with createInventoryLocation and the policies with the Account API.
EBAY_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY=
EBAY_PAYMENT_POLICY=
EBAY_RETURN_POLICY=
# Mercado Libre. Created instantly at developers.mercadolibre.com.mx -- no review
# queue. App ID is the numeric client id; Secret Key is the secret.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://mac-priceit.scanstationai.work/meli/callback
MELI_CONNECTION=chijal
###< survos/marketplace-bundle ###
